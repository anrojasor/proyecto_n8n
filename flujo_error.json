    {
      "parameters": {
        "jsCode": "const fx = v => (typeof v === 'number' && v > 20000)\n  ? new Date(Math.round((v - 25569) * 86400000)).toISOString().slice(0, 19).replace('T', ' ')\n  : (v ?? '');\nconst err = $('Error Trigger').first().json;\nconst msg = err.execution?.error?.message ?? 'Error desconocido';\nconst nodoFallo = err.execution?.lastNodeExecuted ?? '';\nconst ahora = $now.toFormat('yyyy-MM-dd HH:mm:ss');\nreturn $input.all().map(i => {\n  const f = { ...i.json, fecha_solicitud: fx(i.json.fecha_solicitud), fecha_fin: fx(i.json.fecha_fin) };\n  if (String(f.estado).trim().toUpperCase() === 'EN_PROCESO') {\n    f.estado = 'ERROR';\n    f.fecha_fin = ahora;\n    f.mensaje_error = `${nodoFallo}: ${msg}`.slice(0, 500);\n  }\n  return { json: f };\n});"
      },
